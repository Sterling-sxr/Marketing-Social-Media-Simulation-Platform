###############################################################################
# Bread (Sprint 3) - Environment Template
#
# Copy this file to `.env` and adjust values as needed:
#   cp .env.example .env
#
# DO NOT commit real secrets to Git.
###############################################################################

# General
TZ=Australia/Sydney
GATEWAY_PORT=8080
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_DEBUG=1

# Django (set to a long random string in production)
DJANGO_SECRET_KEY=dev-secret-key-change-me

# Postgres
PG_DB=bread
PG_USER=bread
PG_PASSWORD=bread_password_change_me

# RabbitMQ
MQ_USER=bread
MQ_PASS=bread_password_change_me

# MinIO / S3-compatible storage (dev defaults)
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=bread-media
# This should match what users access from the browser (via gateway/nginx).
PUBLIC_MEDIA_URL=http://localhost:8080/media/

# Frontend (dev container only)
# Inside Docker network this should remain http://gateway
VITE_API_BASE=http://gateway

###############################################################################
# Optional integrations (leave blank to disable)
###############################################################################

# DeepSeek (LLM) - optional. Leaving empty disables AI interactions.
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL_NAME=deepseek-chat
DEEPSEEK_POST_DELAY_SECONDS=1.0
DEEPSEEK_AI_USER_DELAY_SECONDS=0.0

# Post analytics snapshot scheduler interval (seconds)
POST_ANALYTICS_REFRESH_INTERVAL=3600

# Teacher invite code (optional; leave blank for no invite requirement)
TEACHER_REGISTRATION_INVITE_CODE=12345678

# Gmail OAuth (optional). Used by demo/verification email sending flows.
# For marking/testing, the system can run without Gmail configured.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=
GMAIL_SENDER=
GMAIL_DEMO_RECIPIENT=
GMAIL_REFRESH_TOKEN=

