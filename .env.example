TZ=UTC
GATEWAY_PORT=8080
ALLOWED_HOSTS=*
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1

# Dashboard refresh / freshness
DASHBOARD_REFRESH_INTERVAL=3600
DASHBOARD_SNAPSHOT_TTL_SECONDS=900
POST_ANALYTICS_REFRESH_INTERVAL=3600

# Local PostgreSQL access.
# With docker-compose, the database is exposed on localhost:15432.
PG_DB=app
PG_USER=app
PG_PASSWORD=app
PG_HOST=127.0.0.1
PG_PORT=15432

# Optional local Redis access for websocket / cache flows.
REDIS_URL=redis://127.0.0.1:6379/0
CHANNEL_REDIS_URL=redis://127.0.0.1:6379/0

# Optional object storage / AI integrations.
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=media
PUBLIC_MEDIA_URL=http://localhost:8080/media
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=
GMAIL_SENDER=
GMAIL_DEMO_RECIPIENT=
GMAIL_REFRESH_TOKEN=
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL_NAME=deepseek-chat
DEEPSEEK_POST_DELAY_SECONDS=1.0
DEEPSEEK_AI_USER_DELAY_SECONDS=0.0
